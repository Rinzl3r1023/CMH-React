# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — secrets NEVER go in the repo (§0.0)
.env
.env*.local
.env.local

# typescript
*.tsbuildinfo

# scratch
/scratch

# generated at build by scripts/sync-covers.mjs (copied from content/posts)
/public/post-covers
# generated at build by scripts/gen-site-images.mjs (derived from /public/images sources)
/public/images/gen
# NOTE: content/posts/**/cover.png is now COMMITTED. The Index covers (Direction B)
# are rendered with headless Chromium (scripts/gen-covers.mjs, `npm run gen:covers`),
# which the build host has no browser for — so they ship as committed assets and
# sync-covers reads them at build. Re-run gen:covers locally when a post is added.
