# ─────────────────────────────────────────────────────────────────────────────
# CMH site — environment variables
# Copy to .env.local for local dev. On Railway, set these as service variables.
# NEVER commit real values. Secrets never live in a document or the repo (§0.0).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin — used to build ABSOLUTE og:image / og:url / canonical /
# sitemap URLs (§5.1). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://chrismichaelharris.com

# The nav "book a call" CTA routes here — Chris's Calendly 30-min event (NOT
# Kim's). This final value is baked as the default; set here only to override.
# Set to an empty string to force the CTA hidden again. Public value (client).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/chris-chrismichaelharris/30min

# The Home coaching card "Learn more" CTA routes to the TBL coaching page. Final
# value baked as default; override here, or empty string to hide. Public (client).
NEXT_PUBLIC_COACHING_URL=https://thebusinesslounge.co/coaching/

# ── Google tags — fail-closed. Loaded only when set; unset = no tag ships (so
#    preview/local builds send no hits). Public (client) values. NEXT_PUBLIC_* is
#    inlined at BUILD time, so Railway must have these set at build, not just
#    runtime. If either is set, the /privacy disclosure must stay accurate.
# GA4 measurement id (G-…), via @next/third-parties. Aggregate traffic analytics.
NEXT_PUBLIC_GA_ID=
# Google Ads conversion tag (AW-…). Carried over from the WordPress site — leaving
# it unset silently breaks Google Ads conversion tracking. Rides the same gtag.js.
NEXT_PUBLIC_GADS_ID=

# ── Kit (ConvertKit) — server-side only. The browser posts to /api/subscribe;
#    that route holds the key and calls Kit. The key must NEVER reach client JS (§6.2).
KIT_API_KEY=
# The Kit FORM id new Dispatch subscribers are added to. NOTE (2026-08): the
# account (The Business Lounge) has no dedicated "The Dispatch" form yet — one
# must be created and its numeric id set here before launch.
KIT_FORM_ID=
# DELIBERATELY UNUSED — leave blank. New-subscriber onboarding (the CMH tag and
# the welcome sequence) is owned by a Kit automation that listens for KIT_FORM_ID,
# so it's one source of truth in Kit, changeable without a deploy, and it also
# covers subscribers arriving from other paths. /api/subscribe does NOT read this
# var or enrol sequences; leaving it unset is intentional, not missing.
KIT_WELCOME_SEQUENCE_ID=

# ── YouTube Data API — server-side only. The /show page fetches through a server
#    route that holds this key; it must NEVER reach client JS (§4.3).
YOUTUBE_API_KEY=
# The channel to pull the Watch shelf from. The feed reads the channel's uploads
# and drops anything ≤3:00 (Shorts) by duration, so the shelf is long-form only.
# Must be the UC… channel id, NOT the @handle — the API needs the id. For
# @HeyCMH, grab it from YouTube Studio → Settings → Channel → Advanced settings,
# or from the channel page source ("channelId":"UC…").
YOUTUBE_CHANNEL_ID=
# Optional / advanced: pull specific curated playlists instead of (or in addition
# to) the channel uploads. Merged with the channel feed, newest first, same
# ≤3-min duration filter applied. Leave blank to just use the channel.
YOUTUBE_PLAYLIST_LIBRARY=
YOUTUBE_PLAYLIST_WHATS_NEXT=
YOUTUBE_PLAYLIST_WHAT_IT_MEANS=
YOUTUBE_PLAYLIST_FIELD_NOTES=
