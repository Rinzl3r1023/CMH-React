# ─────────────────────────────────────────────────────────────────────────────
# CMH site — environment variables
# Copy to .env.local for local dev. On Railway, set these as service variables.
# NEVER commit real values. Secrets never live in a document or the repo (§0.0).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin — used to build ABSOLUTE og:image / og:url / canonical /
# sitemap URLs (§5.1). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://chrismichaelharris.com

# ── Kit (ConvertKit) — server-side only. The browser posts to /api/subscribe;
#    that route holds the key and calls Kit. The key must NEVER reach client JS (§6.2).
KIT_API_KEY=
# The Kit FORM id new Dispatch subscribers are added to. NOTE (2026-08): the
# account (The Business Lounge) has no dedicated "The Dispatch" form yet — one
# must be created and its numeric id set here before launch.
KIT_FORM_ID=
# Optional: a welcome sequence id. If set, new subscribers are also enrolled here
# so a welcome email fires (otherwise they get "first dispatch arrives this week"
# and then silence until the next broadcast).
KIT_WELCOME_SEQUENCE_ID=

# ── YouTube Data API — server-side only. The /show page fetches through a server
#    route that holds this key; it must NEVER reach client JS (§4.3).
YOUTUBE_API_KEY=
# Three playlist ids, one per editorial bucket (§4.2). Supplied by Chris.
#   Bucket 1: What's Next   Bucket 2: What It Means   Bucket 3: Field Notes
YOUTUBE_PLAYLIST_WHATS_NEXT=
YOUTUBE_PLAYLIST_WHAT_IT_MEANS=
YOUTUBE_PLAYLIST_FIELD_NOTES=
